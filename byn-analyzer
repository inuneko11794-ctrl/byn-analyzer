// フォームから買い目収集
function getTicketsFromForm() {
  const rows = document.querySelectorAll('#ticketsContainer > div');
  const tickets = [];
  rows.forEach(row => {
    const combo = row.querySelector('.ticket-combo').value.trim();
    const amount = parseInt(row.querySelector('.ticket-amount').value) || 0;
    if (combo && amount > 0) {
      tickets.push({ combo, amount });
    }
  });
  return tickets;
}

// フォームの推奨サイト選択バッジ更新
function updateOverlapBadge() {
  const sites = [];
  if (document.getElementById('siteB').checked) sites.push('B');
  if (document.getElementById('siteY').checked) sites.push('Y');
  if (document.getElementById('siteN').checked) sites.push('N');

  const key = getPatternKey(sites);
  const badge = document.getElementById('overlapDisplayBadge');

  if (key === 'NONE') {
    badge.className = "text-xs px-2.5 py-1 rounded-full bg-slate-700 text-slate-300 font-bold";
    badge.textContent = "選択なし";
  } else {
    const pat = PATTERNS.find(p => p.id === key);
    badge.className = `text-xs px-2.5 py-1 rounded-full border font-bold ${pat.badgeClass}`;
    badge.textContent = pat.label;
  }
}

// レース保存
function saveRace(e) {
  e.preventDefault();

  const sites = [];
  if (document.getElementById('siteB').checked) sites.push('B');
  if (document.getElementById('siteY').checked) sites.push('Y');
  if (document.getElementById('siteN').checked) sites.push('N');

  if (sites.length === 0) {
    alert('推奨サイト（B, Y, N）を少なくとも1つ選択してください。');
    return;
  }

  const tickets = getTicketsFromForm();
  if (tickets.length === 0) {
    alert('買い目を少なくとも1つ入力してください。');
    return;
  }

  const resultCombo = document.getElementById('resultCombo').value.trim();
  const payoutAmount = parseInt(document.getElementById('payoutAmount').value) || 0;

  // 的中判定 & 収支計算
  let totalInvest = 0;
  let totalReturn = 0;
  let isHit = false;

  tickets.forEach(t => {
    totalInvest += t.amount;
    if (resultCombo && t.combo === resultCombo) {
      isHit = true;
      totalReturn += (t.amount / 100) * payoutAmount;
    }
  });

  const drawingData = canvas.toDataURL();

  const raceData = {
    id: document.getElementById('editRaceId').value || 'race_' + Date.now(),
    date: document.getElementById('raceDate').value,
    venue: document.getElementById('venue').value || '未定',
    raceNum: document.getElementById('raceNum').value || '1',
    sites: sites,
    patternKey: getPatternKey(sites),
    roughness: document.querySelector('input[name="roughness"]:checked').value,
    resultCombo: resultCombo,
    payoutAmount: payoutAmount,
    tickets: tickets,
    totalInvest: totalInvest,
    totalReturn: totalReturn,
    isHit: isHit,
    drawingData: drawingData,
    createdAt: new Date().toISOString()
  };

  const existingIdx = races.findIndex(r => r.id === raceData.id);
  if (existingIdx >= 0) {
    races[existingIdx] = raceData;
  } else {
    races.unshift(raceData);
  }

  saveData();
  resetForm();
}

