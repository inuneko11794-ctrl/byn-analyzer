// 📸 OCR & 画像解析モーダル処理
function openOcrModal() {
  document.getElementById('ocrModal').classList.remove('hidden');
}

function closeOcrModal() {
  document.getElementById('ocrModal').classList.add('hidden');
}

function handleImageUpload(e) {
  const files = e.target.files;
  if (files && files.length > 0) {
    processImageFiles(files);
  }
}

function handlePasteImage(e) {
  const items = (e.clipboardData || e.originalEvent.clipboardData).items;
  const files = [];
  for (let item of items) {
    if (item.type.indexOf('image') !== -1) {
      files.push(item.getAsFile());
    }
  }
  if (files.length > 0) {
    openOcrModal();
    processImageFiles(files);
  }
}

function processImageFiles(files) {
  const status = document.getElementById('ocrStatus');
  const preview = document.getElementById('ocrPreviewImage');
  const placeholder = document.getElementById('ocrPlaceholder');

  status.classList.remove('hidden');
  
  const reader = new FileReader();
  reader.onload = (e) => {
    preview.src = e.target.result;
    preview.classList.remove('hidden');
    placeholder.classList.add('hidden');

    // Tesseract.js 解析
    Tesseract.recognize(e.target.result, 'jpn+eng', { logger: m => console.log(m) })
      .then(({ data: { text } }) => {
        status.classList.add('hidden');
        parseOcrText(text);
      })
      .catch(err => {
        status.classList.add('hidden');
        console.error(err);
      });
  };
  reader.readAsDataURL(files[0]);
}

// OCRテキスト解析ロジック
function parseOcrText(text) {
  // レース番号抽出 (例: 1R)
  const rMatch = text.match(/([1-9]|1[0-2])\s*R/i);
  if (rMatch) {
    document.getElementById('modalRaceNum').value = rMatch[1];
  }

  // 決定着順 (例: 5-1-6 や 5 1 6)
  const comboMatch = text.match(/([1-9])\s*[-ー‐]?\s*([1-9])\s*[-ー‐]?\s*([1-9])/);
  if (comboMatch) {
    document.getElementById('rank1').value = comboMatch[1];
    document.getElementById('rank2').value = comboMatch[2];
    document.getElementById('rank3').value = comboMatch[3];
  }

  // 配当金抽出 (例: 920円)
  const payoutMatch = text.match(/([0-9,]+)\s*円/);
  if (payoutMatch) {
    const amt = payoutMatch[1].replace(/,/g, '');
    document.getElementById('modalPayout').value = amt;
  }
}

