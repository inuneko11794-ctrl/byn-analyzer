// 統計計算
function calculateStats() {
  const stats = {};
  PATTERNS.forEach(p => {
    stats[p.id] = { count: 0, hits: 0, invest: 0, returnAmt: 0, hitRate: 0, roi: 0 };
  });

  races.forEach(r => {
    const pKey = r.patternKey;
    if (stats[pKey]) {
      stats[pKey].count++;
      if (r.isHit) stats[pKey].hits++;
      stats[pKey].invest += r.totalInvest;
      stats[pKey].returnAmt += r.totalReturn;
    }
  });

  PATTERNS.forEach(p => {
    const s = stats[p.id];
    s.hitRate = s.count > 0 ? ((s.hits / s.count) * 100).toFixed(1) : 0;
    s.roi = s.invest > 0 ? ((s.returnAmt / s.invest) * 100).toFixed(1) : 0;
  });

  return stats;
}

